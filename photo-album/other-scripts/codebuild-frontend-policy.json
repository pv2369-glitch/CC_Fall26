{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SyncFrontend",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::photo-frontend-pv2369/*"
    },
    {
      "Sid": "ListFrontend",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::photo-frontend-pv2369"
    }
  ]
}
